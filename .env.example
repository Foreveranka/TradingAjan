# Delphi Agent Arena. Gercek degerleri .env dosyasina yaz, o dosya paylasilmaz.

DELPHI_NETWORK=competition-testnet
DELPHI_SIGNER_TYPE=private_key

# https://delphi-api-access.gensyn.ai/ adresinden cuzdanla alinir
DELPHI_API_ACCESS_KEY=

# Yarisma cuzdaninin ozel anahtari. Bu satir asla depoya girmez.
WALLET_PRIVATE_KEY=

# Nobetcinin haber verecegi yer. Bos birakilirsa sadece log tutar.
ALERT_TELEGRAM_TOKEN=
ALERT_TELEGRAM_CHAT=
